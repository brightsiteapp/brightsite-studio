{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.brightsite.app"
        }
      ],
      "destination": "https://brightsite.app/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/work",
      "destination": "/ourwork",
      "permanent": true
    },
    {
      "source": "/work.html",
      "destination": "/ourwork",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/register-domain",
      "schedule": "0 4 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/s/:slug",
      "destination": "https://brightsite-upload.notify-lead-worker.workers.dev/site/:slug/"
    },
    {
      "source": "/s/:slug/:path*",
      "destination": "https://brightsite-upload.notify-lead-worker.workers.dev/site/:slug/:path*"
    }
  ]
}
